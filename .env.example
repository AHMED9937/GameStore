# Copy to .env and fill in real values (never commit .env)
#
# Deployment (DEPLOYMENT_PLAN.md) — env host matrix:
#   Vercel (web):  NEXT_PUBLIC_*, API_URL, Clerk keys + webhook, DATABASE_URL (Clerk sync),
#                  Stripe publishable only, optional SENTRY_DSN / NEXT_PUBLIC_SENTRY_DSN
#   Railway (api): DATABASE_URL, DIRECT_URL, CORS_ORIGINS, NODE_ENV=production, Clerk secret,
#                  Stripe secret + webhook, STEAM_*, IGDB_*, THROTTLE_*, optional SENTRY_DSN
#   PORT is injected by Railway — do not hardcode on the API service.
#
# Staging vs production: use separate Neon branches, Clerk instances, Stripe modes, and a
# unique STEAM_ENCRYPTION_KEY per environment. Store values in a password manager — never git.
#
# Staging secrets: pnpm deploy:init-staging-env  →  edit .env.staging (gitignored)
# D1 gate: pnpm deploy:verify-env -- --file .env.staging
# D1 keys: DATABASE_URL, DIRECT_URL, Clerk, Stripe Test, IGDB, STEAM_ENCRYPTION_KEY

# Neon PostgreSQL (required Clerk Neon integration)
# Get connection strings from https://console.neon.tech
# DATABASE_URL  = pooled connection string (?sslmode=require) Next.js + Nest runtime
# DIRECT_URL    = direct connection string Prisma migrations only
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# App
NODE_ENV=development
# Railway sets PORT for Nest — local dev uses 3333 via nx serve api
# PORT=
# NestJS must NOT be the same port as Next.js (default 3000)
API_URL=http://localhost:3333
NEXT_PUBLIC_API_URL=http://localhost:3000/api
# Public storefront origin (no trailing slash). Local: http://localhost:3000
# Production (Vercel + Railway): https://offlinegamenia.com — required on Railway for Stripe success/cancel URLs
# SITE_URL=                    # optional alias; preferred over NEXT_PUBLIC_SITE_URL on Nest if both set
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Comma-separated browser origins allowed to call Nest directly (Slice S.2 CORS)
# Production: set to your real https:// domains only (no wildcard)
CORS_ORIGINS=http://localhost:3000,http://localhost:4200
NEXT_PUBLIC_SITE_NAME=GameStore
NEXT_PUBLIC_DEFAULT_OG_IMAGE=/og/default.png
# Optional Discord invite shown on FAQ, game detail, footer, contact
# NEXT_PUBLIC_DISCORD_INVITE_URL=https://discord.gg/your-server
#
# Discord bot setup (D.0 — run pnpm discord:setup after manual steps in DISCORD_PLAN.md)
# DISCORD_BOT_TOKEN=                          from https://discord.com/developers/applications
# DISCORD_GUILD_ID=                           right-click server → Copy Server ID (Developer Mode on)
#
# Discord publish announcements (D.1 — output by discord:setup or create webhook manually)
# Same webhook is used to create, edit, and delete publish posts when games are saved/unpublished.
# DISCORD_NEW_GAMES_WEBHOOK_URL=https://discord.com/api/webhooks/...
# DISCORD_NEW_GAMES_ROLE_ID=                  snowflake for the NewGames role
#
# Discord AI support bot (D.2 — pnpm discord:bot)
# Enable Message Content Intent in Discord Developer Portal → Bot
# DISCORD_OWNER_USER_ID=                      right-click your user → Copy User ID
# GEMINI_API_KEY=                             from https://aistudio.google.com/apikey
# If you see 429 quota errors: enable billing at https://aistudio.google.com/apikey
# GEMINI_MODEL=gemini-2.0-flash               try gemini-2.5-flash-preview when quota allows
# DISCORD_STAFF_ROLE_ID=                      optional — ping @Staff on new auto-tickets
# DISCORD_TICKETS_CHANNEL_ID=                 optional — forum channel (printed by discord:setup)
# DISCORD_POST_HELP_STICKY=true               optional — post help sticky on bot startup

# Stripe (SP.0 required before checkout; see STRIPE_PHASE_PLAN.md)
# STRIPE_SECRET_KEY                  = sk_test_... or sk_live_... (server only NestJS)
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY = pk_test_... or pk_live_... (browser safe to expose)
# STRIPE_WEBHOOK_SECRET              = whsec_... (server only from Stripe CLI or Dashboard)
#
# Webhooks must hit Nest directly (API_URL / port 3333), not through Next.js /api BFF.
# Stripe signature verification needs the raw request body; the BFF forwards
# stripe-signature if needed, but local dev should use the Nest URL below.
#
# Local webhook forwarding (recommended for production-like flow):
#   stripe listen --forward-to localhost:3333/api/payments/webhook
# Copy the whsec_... signing secret into STRIPE_WEBHOOK_SECRET, then restart the API.
#
# Without webhooks, the checkout success page still fulfills orders by syncing the
# Stripe session when you poll GET /orders/by-session/:sessionId (dev convenience).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# IGDB (admin metadata import Phase AD.5)
# Create Twitch app at https://dev.twitch.tv/console/apps and enable IGDB API access
# See libs/api/igdb/README.md for setup steps
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# Steam (Phase 5 + Steam phase ST.1–ST.5)
# STEAM_ENCRYPTION_KEY         = 64-char hex (32 bytes) or 32+ char secret (server only NestJS)
# STEAM_GUARD_COOLDOWN_MINUTES = minutes between guard code requests per account (default 15)
STEAM_ENCRYPTION_KEY=
STEAM_GUARD_COOLDOWN_MINUTES=15
# Optional encrypt demo pool accounts when running `pnpm seed` (local activation on DEMO-KEY-*)
# SEED_STEAM_PASSWORD=seed-demo-pool-password
# SEED_STEAM_SHARED_SECRET=testsharedsecretfortotp123456

# Rate limiting (NestJS Slice S.7)
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT_DEFAULT=100
THROTTLE_LIMIT_GAMES=60
THROTTLE_LIMIT_LICENSE_VALIDATE=10
THROTTLE_LIMIT_STEAM_GUARD=5
THROTTLE_LIMIT_CHECKOUT=20
THROTTLE_LIMIT_AUTH=20
THROTTLE_LIMIT_IGDB=10

# Clerk (auth SECURITY_PLAN Slice S.1+)
# Create app at https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
# Webhook signing secret (Clerk Dashboard → Webhooks → endpoint)
# Either name works verifyWebhook reads CLERK_WEBHOOK_SIGNING_SECRET first
CLERK_WEBHOOK_SECRET=whsec_...
# CLERK_WEBHOOK_SIGNING_SECRET=whsec_...
# Optional match Clerk Dashboard → Component paths (development host)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# Staff admin panel uses a separate route: /admin/sign-in (not configured in Clerk paths)
#
# Required for fast /admin access without extra Clerk API lookups (recommended):
# Clerk Dashboard → Sessions → Customize session token:
# { "metadata": "{{user.public_metadata}}" }
#
# Admin user in Clerk → Public metadata: { "role": "admin" }

# Observability (DEPLOYMENT_PLAN D9 — optional until monitoring slice)
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=
