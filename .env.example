# Copy to .env and fill in real values (never commit .env)

# Neon PostgreSQL (required — Clerk Neon integration)
# Get connection strings from https://console.neon.tech
# DATABASE_URL  = pooled connection string (?sslmode=require) — Next.js + Nest runtime
# DIRECT_URL    = direct connection string — Prisma migrations only
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# App
NODE_ENV=development
# NestJS — must NOT be the same port as Next.js (default 3000)
API_URL=http://localhost:3333
NEXT_PUBLIC_API_URL=http://localhost:3000/api
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Comma-separated browser origins allowed to call Nest directly (Slice S.2 CORS)
# Production: set to your real https:// domains only (no wildcard)
CORS_ORIGINS=http://localhost:3000,http://localhost:4200
NEXT_PUBLIC_SITE_NAME=GameStore
NEXT_PUBLIC_DEFAULT_OG_IMAGE=/og/default.png

# Stripe (setup only — Phase 4; optional until checkout is implemented)
# STRIPE_SECRET_KEY                  = sk_test_... or sk_live_... (server only — NestJS)
# STRIPE_WEBHOOK_SECRET              = whsec_... (server only — webhook signature verification)
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY = pk_test_... or pk_live_... (browser — safe to expose)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Steam (setup only — Phase 5; optional until Guard is implemented)
# STEAM_ENCRYPTION_KEY         = 64-char hex (32 bytes) or 32+ char secret (server only — NestJS)
# STEAM_GUARD_COOLDOWN_MINUTES = minutes between guard code requests per account (default 15)
STEAM_ENCRYPTION_KEY=
STEAM_GUARD_COOLDOWN_MINUTES=15

# Rate limiting (NestJS — Slice S.7)
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT_DEFAULT=100
THROTTLE_LIMIT_GAMES=60
THROTTLE_LIMIT_LICENSE_VALIDATE=10
THROTTLE_LIMIT_STEAM_GUARD=5
THROTTLE_LIMIT_AUTH=20

# Clerk (auth — SECURITY_PLAN Slice S.1+)
# Create app at https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
# Webhook signing secret (Clerk Dashboard → Webhooks → endpoint)
# Either name works — verifyWebhook reads CLERK_WEBHOOK_SIGNING_SECRET first
CLERK_WEBHOOK_SECRET=whsec_...
# CLERK_WEBHOOK_SIGNING_SECRET=whsec_...
# Optional — match Clerk Dashboard → Component paths (development host)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# Staff admin panel uses a separate route: /admin/sign-in (not configured in Clerk paths)
#
# Required for fast /admin access without extra Clerk API lookups (recommended):
# Clerk Dashboard → Sessions → Customize session token:
# { "metadata": "{{user.public_metadata}}" }
#
# Admin user in Clerk → Public metadata: { "role": "admin" }
