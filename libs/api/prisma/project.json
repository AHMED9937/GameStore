{
  "name": "api-prisma",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/api/prisma/src",
  "projectType": "library",
  "tags": ["scope:api", "type:integration", "platform:database"],
  "targets": {
    "build": {
      "dependsOn": ["prisma-generate", "^build"]
    },
    "prisma-generate": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{projectRoot}/prisma/schema.prisma",
        "{projectRoot}/prisma/migrations/**/*"
      ],
      "options": {
        "command": "prisma generate --schema=libs/api/prisma/prisma/schema.prisma"
      }
    },
    "prisma-migrate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "prisma migrate dev --schema=libs/api/prisma/prisma/schema.prisma --skip-seed"
      }
    },
    "prisma-migrate-deploy": {
      "executor": "nx:run-commands",
      "options": {
        "command": "prisma migrate deploy --schema=libs/api/prisma/prisma/schema.prisma"
      }
    },
    "db-seed": {
      "executor": "nx:run-commands",
      "options": {
        "command": "prisma db seed --schema=libs/api/prisma/prisma/schema.prisma"
      }
    },
    "igdb-seed": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx tsx scripts/igdb-seed.ts"
      }
    },
    "prisma-studio": {
      "executor": "nx:run-commands",
      "options": {
        "command": "prisma studio --schema=libs/api/prisma/prisma/schema.prisma"
      }
    },
    "test": {
      "executor": "@nx/vitest:test",
      "outputs": ["{options.reportsDirectory}"],
      "options": {
        "reportsDirectory": "coverage/libs/api/prisma"
      }
    }
  }
}
