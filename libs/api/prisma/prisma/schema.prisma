generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Game {
  id              String   @id @default(cuid())
  title           String
  slug            String   @unique
  description     String?
  platform        String
  priceBase       Decimal  @db.Decimal(10, 2)
  coverImage      String?
  coverCardImage  String?
  metaTitle       String?
  metaDescription String?
  ogImage         String?
  publishedAt     DateTime?
  igdbId          Int?      @unique
  releaseDate     DateTime?
  genres          String[]  @default([])
  igdbSyncedAt    DateTime?
  igdbCoverUrl    String?
  requirementsMin         String? @db.Text
  requirementsRecommended String? @db.Text
  featuredOrder   Int?
  soldOut         Boolean  @default(false)
  discordPublishMessageId String?
  discordAnnounceDescription String? @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  pricingRegions       GamePricingRegion[]
  accounts             GameAccount[]
  licenses             License[]
  media                GameMedia[]
  orders               Order[]
  subscriptionPlanGames SubscriptionPlanGame[]

  @@index([featuredOrder])
  @@index([publishedAt])
  @@map("games")
}

/// IGDB-synced gallery media (screenshots + trailer videos) for game detail pages.
model GameMedia {
  id        String   @id @default(cuid())
  gameId    String
  /// `screenshot` | `video` (YouTube embed URL from IGDB game_videos)
  type      String
  url       String
  igdbId    Int?
  title     String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@index([gameId, type, sortOrder])
  @@map("game_media")
}

model GamePricingRegion {
  id            String  @id @default(cuid())
  gameId        String
  countryCode   String  @db.VarChar(2)
  priceAdjusted Decimal @db.Decimal(10, 2)
  currency      String  @default("USD") @db.VarChar(3)

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([gameId, countryCode])
  @@map("game_pricing_regions")
}

model GameAccount {
  id                String    @id @default(cuid())
  gameId            String?
  platform          String
  username          String
  passwordEncrypted String
  sharedSecret      String
  region            String    @default("global")
  activeUsersCount  Int       @default(0)
  maxActiveUsers    Int       @default(50)
  isActive          Boolean   @default(true)
  lockedUntil              DateTime?
  guardLockedByLicenseId   String?
  lastHealthCheck          DateTime?
  createdAt         DateTime  @default(now())

  game     Game?     @relation(fields: [gameId], references: [id], onDelete: SetNull)
  licenses License[]

  @@index([gameId, isActive])
  @@map("game_accounts")
}

model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  email     String   @unique
  firstName String?
  lastName  String?
  role      String   @default("user")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  licenses      License[]
  auditLogs     AuditLog[]
  orders        Order[]
  subscriptions UserSubscription[]

  @@map("users")
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  resource   String?
  resourceId String?
  ip         String?
  userAgent  String?
  metadata   Json?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

model License {
  id             String    @id @default(cuid())
  licenseKey     String    @unique
  gameId         String
  accountId      String?
  ownerId        String?
  subscriptionId String?
  source         String    @default("admin")
  status         String    @default("available")
  buyerEmail     String?
  buyerCountry   String?   @db.VarChar(2)
  validFrom      DateTime  @default(now())
  expiresAt      DateTime?
  activatedAt    DateTime?
  createdAt      DateTime  @default(now())

  game         Game              @relation(fields: [gameId], references: [id], onDelete: Cascade)
  account      GameAccount?      @relation(fields: [accountId], references: [id], onDelete: SetNull)
  owner        User?             @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  subscription UserSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  order        Order?

  @@unique([subscriptionId, gameId, ownerId], name: "subscription_game_owner")
  @@index([gameId, status])
  @@index([ownerId])
  @@index([subscriptionId])
  @@index([expiresAt])
  @@index([source, status])
  @@map("licenses")
}

model Order {
  id                String   @id @default(cuid())
  gameId            String?
  gameTitleSnapshot String?
  gameSlugSnapshot  String?
  ownerId           String?
  licenseId         String?  @unique
  stripeSessionId   String   @unique
  stripePaymentId   String?
  orderType         String   @default("one_time")
  amount            Decimal  @db.Decimal(10, 2)
  currency          String   @default("USD") @db.VarChar(3)
  status            String   @default("pending")
  buyerEmail        String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  game    Game?    @relation(fields: [gameId], references: [id], onDelete: SetNull)
  license License? @relation(fields: [licenseId], references: [id], onDelete: SetNull)
  owner   User?    @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([gameId, status])
  @@index([ownerId])
  @@map("orders")
}

model SubscriptionPlan {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  stripePriceId String   @unique
  interval      String
  intervalCount Int      @default(1)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  games         SubscriptionPlanGame[]
  subscriptions UserSubscription[]

  @@map("subscription_plans")
}

model SubscriptionPlanGame {
  planId String
  gameId String

  plan SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  game Game             @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@id([planId, gameId])
  @@map("subscription_plan_games")
}

model UserSubscription {
  id                   String   @id @default(cuid())
  userId               String
  planId               String
  stripeSubscriptionId String   @unique
  stripeCustomerId     String?
  status               String
  currentPeriodStart   DateTime
  currentPeriodEnd     DateTime
  cancelAtPeriodEnd    Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan     SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  licenses License[]

  @@index([userId, status])
  @@map("user_subscriptions")
}

/// Key-value store settings (e.g. default activation video URL).
model StoreSetting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt

  @@map("store_settings")
}
