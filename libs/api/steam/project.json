{
  "name": "api-steam",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/api/steam/src",
  "projectType": "library",
  "tags": ["scope:api", "type:integration", "platform:steam"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/api/steam",
        "main": "libs/api/steam/src/index.ts",
        "tsConfig": "libs/api/steam/tsconfig.lib.json",
        "assets": ["libs/api/steam/*.md"]
      }
    },
    "test": {
      "executor": "@nx/vitest:test",
      "outputs": ["{options.reportsDirectory}"],
      "options": {
        "reportsDirectory": "coverage/libs/api/steam"
      }
    }
  }
}
