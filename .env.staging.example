# GameStore STAGING — copy to .env.staging and fill in real values (never commit .env.staging)
#
#   pnpm deploy:init-staging-env
#   pnpm deploy:verify-env -- --file .env.staging
#
# Keep your local .env for local dev. This file holds staging-only secrets for
# Railway (D2) and Vercel (D3). Use Neon branch: staging (NOT main/production).

# --- Neon (staging branch @ console.neon.tech) ---
# DATABASE_URL = Pooled connection (?sslmode=require, host contains -pooler)
# DIRECT_URL   = Direct connection (?sslmode=require, no pooler) — migrations only
DATABASE_URL=
DIRECT_URL=

# --- Clerk (dedicated staging instance — not local dev Clerk) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# CLERK_WEBHOOK_SECRET=                    # D3 — after Vercel URL exists

# --- Paddle Test mode only (staging) ---
PADDLE_API_KEY=
# PADDLE_NOTIFICATION_WEBHOOK_SECRET=      # D2 — after Railway API URL exists
NEXT_PUBLIC_PADDLE_ENV=sandbox

# --- IGDB / Twitch (admin import on Railway) ---
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# --- Steam (staging-unique key — must differ from local .env) ---
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
STEAM_ENCRYPTION_KEY=
STEAM_GUARD_COOLDOWN_MINUTES=15

# --- Discord game announcements (Railway Nest — D.1) ---
# Create webhook on 🎮 | new-games (or run: pnpm discord:setup)
# DISCORD_NEW_GAMES_WEBHOOK_URL=https://discord.com/api/webhooks/...
# DISCORD_NEW_GAMES_ROLE_ID=                  # optional @NewGames ping on first publish
# NEXT_PUBLIC_DISCORD_INVITE_URL=https://discord.gg/...  # Vercel site CTAs

# --- Railway API (D2) — set in Railway dashboard from this file + webhook secret ---
# NODE_ENV=production
# NEXT_PUBLIC_SITE_URL=https://offlinegamenia.com
#   Required on Railway for Paddle success/cancel redirects (SITE_URL alias also works)
# CORS_ORIGINS=https://offlinegamenia.com
# PADDLE_NOTIFICATION_WEBHOOK_SECRET=      # after Railway URL: Paddle Test notification destination → /api/payments/webhook
#
# Smoke after Railway deploy:
#   pnpm deploy:smoke-api -- --url https://gamestore-production-4a06.up.railway.app --print-webhook

# --- Vercel web (D3) — Root Directory EMPTY; Output Directory = apps/web/.next (Nx official) ---
# Framework = Next.js. Build Command = pnpm run vercel-build (root vercel.json).
# API_URL=https://gamestore-production-4a06.up.railway.app
# NEXT_PUBLIC_API_URL=/api
# NEXT_PUBLIC_SITE_URL=https://offlinegamenia.com
# NEXT_PUBLIC_SITE_NAME=OfflineGameNIA
# NEXT_PUBLIC_DEFAULT_OG_IMAGE=/og/default.png
# CLERK_WEBHOOK_SECRET=                    # after Clerk webhook → https://<web>/api/webhooks
# DATABASE_URL / DIRECT_URL               # same Neon staging (Prisma on web for Clerk sync)
#
# After Vercel deploy + Railway CORS_ORIGINS=https://offlinegamenia.com:
#   pnpm deploy:smoke-web -- --url https://offlinegamenia.com --print-clerk-webhook
