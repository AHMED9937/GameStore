{
  "$schema": "https://json-schema.org/schema",
  "$id": "UiLib",
  "title": "Add a shared UI primitive",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Component name (e.g. button, card)",
      "$default": { "$source": "argv", "index": 0 },
      "x-prompt": "Component name?"
    }
  },
  "required": ["name"]
}
