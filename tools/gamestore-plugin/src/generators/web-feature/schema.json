{
  "$schema": "https://json-schema.org/schema",
  "$id": "WebFeature",
  "title": "Create a web feature library and route shell",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "$default": { "$source": "argv", "index": 0 },
      "x-prompt": "Feature name (e.g. catalog)?"
    },
    "route": {
      "type": "string",
      "description": "App router path (e.g. /shop)"
    }
  },
  "required": ["name"]
}
