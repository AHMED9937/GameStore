{
  "$schema": "https://json-schema.org/schema",
  "$id": "E2eSpec",
  "title": "Create Playwright e2e spec scaffold",
  "type": "object",
  "properties": {
    "app": {
      "type": "string",
      "default": "web",
      "description": "App name (web or api)"
    },
    "name": {
      "type": "string",
      "$default": { "$source": "argv", "index": 0 },
      "x-prompt": "Spec name?"
    }
  },
  "required": ["name"]
}
